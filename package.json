{
  "name": "payment-simulation",
  "private": true,
  "description": "Payment processing simulation: Express microservice with JSON file persistence and a Next.js dashboard",
  "packageManager": "pnpm@9.2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "pnpm build:shared",
    "build:shared": "pnpm --filter @payment-sim/shared build",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "test": "pnpm build:shared && pnpm -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
