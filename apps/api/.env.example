# Copy to .env for local development. Every value is optional and validated at boot (src/config).

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Number of proxy hops to trust for client IPs (1 behind a platform load balancer).
TRUST_PROXY=0

# Persistence: one JSON file, written atomically after every committed change.
# Leave empty to keep everything in memory (data is lost on restart). One process per file.
DATA_FILE=./data/payments.json

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_WRITE_MAX=60

# Payment worker (persisted job queue). Disable to run an API-only process.
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
WORKER_LOCK_TIMEOUT_MS=60000
JOB_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000

# Simulated gateway. Test cards behave deterministically (see packages/shared/src/test-cards.ts);
# other cards are declined / fail transiently at these rates.
GATEWAY_MIN_LATENCY_MS=300
GATEWAY_MAX_LATENCY_MS=2500
GATEWAY_TIMEOUT_MS=3000
GATEWAY_DECLINE_RATE=0.1
GATEWAY_TRANSIENT_ERROR_RATE=0.15

# Live updates over Server-Sent Events.
SSE_HEARTBEAT_MS=15000
SSE_MAX_CLIENTS=500
SSE_REPLAY_LIMIT=500
