# Copy to .env for local development. Every value is validated at boot (src/config).

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Number of proxy hops to trust for client IPs (1 behind Render's load balancer).
TRUST_PROXY=0

# Neon: pooled URL for queries, direct (unpooled) URL for LISTEN/NOTIFY.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_WRITE_MAX=60
