# Copy to .env for local development. Every value is validated at boot (src/config).

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Number of proxy hops to trust for client IPs (1 behind Render's load balancer).
TRUST_PROXY=0

# Neon: pooled URL for queries, direct (unpooled) URL for LISTEN/NOTIFY.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_WRITE_MAX=60

DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_SLOW_QUERY_MS=500

# Integration tests only (pnpm test:int). The database name must end in _test because the
# suite drops and recreates its schema. Defaults to postgresql://localhost:5432/payments_test.
# TEST_DATABASE_URL=

# Payment worker (Postgres-backed job queue). Disable to run API-only instances.
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
WORKER_LOCK_TIMEOUT_MS=60000
JOB_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000

# Simulated gateway. Test cards behave deterministically (see packages/shared/src/test-cards.ts);
# other cards are declined / fail transiently at these rates.
GATEWAY_MIN_LATENCY_MS=300
GATEWAY_MAX_LATENCY_MS=2500
GATEWAY_TIMEOUT_MS=3000
GATEWAY_DECLINE_RATE=0.1
GATEWAY_TRANSIENT_ERROR_RATE=0.15
