[
  { "goto": "/payments/new" },
  { "expect": { "role": "form", "name": "Create payment" } },
  { "click": { "role": "radio", "name": "Success (ending 4242)" } },
  { "fill": { "label": "Amount", "value": "1234.56" } },
  { "fill": { "label": "Description", "value": "verify ${runId}: create" } },
  { "snapshot": "01-form-filled" },
  { "click": { "role": "button", "name": "Create payment", "exact": true } },
  { "expectUrl": "/payments/[0-9a-f-]{36}$" },
  { "saveUrlMatch": { "var": "paymentId", "regex": "/payments/([0-9a-f-]{36})" } },
  { "expectText": { "text": "NGN 1,234.56" } },
  { "expect": { "role": "status", "name": "Status: SUCCEEDED", "timeout": 15000 } },
  { "snapshot": "02-detail-succeeded" },
  { "screenshot": "02-detail-succeeded" }
]
